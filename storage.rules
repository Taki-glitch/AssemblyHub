rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() ? userDoc().data.role : null;
    }

    function canManageDocuments() {
      return role() == 'administrateur' || (role() == 'éditeur' && 'documents' in userDoc().data.privileges);
    }

    match /documents/{allPaths=**} {
      allow read: if signedIn();
      allow write: if canManageDocuments();
    }
  }
}
